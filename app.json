{
  "expo": {
    "name": "List Kitty",
    "slug": "list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "list",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#EDE4D4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.goode_company.listkitty"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "splash": {
        "backgroundColor": "#FFF8EF",
        "image": "./assets/images/splash-light.png",
        "imageWidth": 180
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EF",
          "image": "./assets/images/splash-light.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#1A1612",
            "image": "./assets/images/splash-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow List Kitty to use Face ID to unlock the app."
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd6aa440-0d80-41c4-b6c9-c8d303c0b47e"
      }
    }
  }
}
